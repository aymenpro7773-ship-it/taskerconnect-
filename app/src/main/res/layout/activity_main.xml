<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="84dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="22dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivAppLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="شعار connect net"
                    android:scaleType="centerCrop"
                    android:src="@drawable/connect_net_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONNECT NET • ELITE 2027"
                        android:textColor="@color/accent_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvServiceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="حالة الخدمة: متوقفة"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="ليلي/نهاري"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#2563EB"
                    app:cornerRadius="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1) قسم الرئيسية -->
                <LinearLayout
                    android:id="@+id/sectionHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#1D4ED8"
                            app:cardCornerRadius="22dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="مبيعات اليوم"
                                    android:textColor="#DBEAFE"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvTodaySalesCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="0"
                                    android:textColor="#FFFFFF"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#0F766E"
                            app:cardCornerRadius="22dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="إجمالي المخزون"
                                    android:textColor="#CCFBF1"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvTotalStockCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="0"
                                    android:textColor="#FFFFFF"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartService"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="تشغيل الخدمة"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2563EB"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopService"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="إيقاف الخدمة"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#334155"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReportDaily"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="يومي"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1E40AF"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReportWeekly"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="أسبوعي"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1E3A8A"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReportMonthly"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="شهري"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#172554"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProcessQueue"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="معالجة الانتظار"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0284C7"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRetryFailed"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="إعادة الفاشل"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0D9488"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2) قسم الإرسال والمحاكاة -->
                <LinearLayout
                    android:id="@+id/sectionSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المحاكاة والإرسال وإعادة المحاولة"
                        android:textColor="@color/accent_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:hint="رقم المستلم (مثال: 771234567)"
                        android:inputType="phone"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <EditText
                        android:id="@+id/etMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:gravity="top"
                        android:hint="نص الرسالة / المحاكاة (مثال: اضيف 500 771234567 jaib)"
                        android:lines="3"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimulate"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="محاكاة"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2563EB"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendReal"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="إرسال SMS"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0D9488"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3) قسم المخزن والملفات والفئات -->
                <LinearLayout
                    android:id="@+id/sectionStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المخزن والملفات وتعديل الفئات"
                        android:textColor="@color/accent_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCat100"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="100"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1E40AF"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCat200"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="200"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1E40AF"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCat500"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="500"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1E40AF"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCat1000"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="1000"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1E40AF"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etStockCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:hint="الفئة الحالية للتعديل أو الإضافة (مثال: 100 أو 200)"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <EditText
                        android:id="@+id/etBulkCodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:gravity="top"
                        android:hint="الأكواد / محتوى ملف الفئة (كود بكل سطر)..."
                        android:lines="4"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddCodes"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="إضافة الأكواد"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2563EB"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditCategoryStock"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="تعديل ملف الفئة"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0284C7"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportFile"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="استيراد ملف"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0F766E"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportFile"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="تصدير ملف"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1E40AF"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4) قسم تقرير البيع والاستلام والزبائن والأرشيف -->
                <LinearLayout
                    android:id="@+id/sectionCustomers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تقرير البيع والاستلام والزبائن والأرشيف"
                        android:textColor="@color/accent_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etSearchCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:hint="بحث برقم الزبون..."
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSalesReceiptReport"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="بيع واستلام"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0D9488"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLoadCustomers"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="الزبائن"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1D4ED8"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLoadArchive"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="الأرشيف"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0284C7"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="إضافة / حفظ رقم بديل للزبون"
                        android:textColor="@color/accent_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCustomerAliasKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@color/input_bg"
                        android:hint="المفتاح أو الرقم المختصر الظاهر (مثال: 775137807 أو 617)"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <EditText
                        android:id="@+id/etCustomerAliasPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@color/input_bg"
                        android:hint="الرقم البديل الكامل (مثال: 771234567)"
                        android:inputType="phone"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveCustomerAlias"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:text="حفظ الرقم البديل للزبون"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#0F766E"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <!-- 5) قسم الضبط والقوالب والاحتياطات والبصمة والنقش -->
                <LinearLayout
                    android:id="@+id/sectionSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الضبط والقوالب والاحتياطات والأمان"
                        android:textColor="@color/accent_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etAllowedCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:hint="الفئات المسموحة: 100,200,300,500,1000,2000"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etNewCategory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@color/input_bg"
                            android:hint="فئة جديدة (مثال: 1500)"
                            android:padding="14dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:text="إضافة"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0284C7"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etLowStockThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:hint="حد تنبيه انخفاض المخزون"
                        android:inputType="number"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <EditText
                        android:id="@+id/etKeywordPattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:hint="نمط الكلمة"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <EditText
                        android:id="@+id/etBundlesCsv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:hint="الباقات (مثال: 100:350ميجا,200:700ميجا)"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <EditText
                        android:id="@+id/etReplyTemplate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/input_bg"
                        android:gravity="top"
                        android:hint="قالب الرد العام ({amount} {bundle} {card})"
                        android:lines="2"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="قالب رد مخصص لفئة محددة"
                        android:textColor="@color/accent_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCategoryTemplateCat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@color/input_bg"
                        android:hint="رقم الفئة (مثال: 200 أو 500)"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <EditText
                        android:id="@+id/etCategoryTemplateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@color/input_bg"
                        android:gravity="top"
                        android:hint="نص القالب لهذه الفئة ({amount} {bundle} {card})"
                        android:lines="2"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveCategoryTemplate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="حفظ قالب هذه الفئة"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#1E3A8A"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveRules"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="حفظ القواعد والخصائص"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#2563EB"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOverlayPermission"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:text="إذن الظهور فوق التطبيقات / الاحتياطات"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#0F766E"
                        app:cornerRadius="16dp" />

                    <EditText
                        android:id="@+id/etNewSecret"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@color/input_bg"
                        android:hint="رمز أو نقش الدخول (4 خانات فأكثر)"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveLock"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="تفعيل النقش/الرمز"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#0D9488"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDisableLock"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="إيقاف القفل"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#475569"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBiometricLock"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:text="قفل / فحص بالبصمة"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#1E40AF"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <!-- صندوق النتائج والإشعارات واللوج -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="22dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="النتائج والإشعارات واللوج"
                                android:textColor="@color/accent_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClearLog"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="مسح اللوج"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:backgroundTint="#334155"
                                app:cornerRadius="14dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="4dp"
                            android:text="لا توجد بيانات معروضة بعد."
                            android:textColor="@color/text_primary"
                            android:textIsSelectable="true"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvEventLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/log_bg"
                            android:lineSpacingExtra="3dp"
                            android:padding="12dp"
                            android:text="سجل اللوج فارغ."
                            android:textColor="@color/text_secondary"
                            android:textIsSelectable="true"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/card_bg"
        app:itemIconTint="@color/accent_primary"
        app:itemTextColor="@color/text_primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
